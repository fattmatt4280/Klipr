# Klipr Phase 0 — copy to .env, fill values, NEVER commit the real .env.
# No secrets are in this repo. Production OAuth provider + S3 credentials are VPS steps.
KLIPR_ENV=production
KLIPR_DATABASE_URL=postgresql://klipr_app@localhost:5432/klipr
KLIPR_STORAGE_DRIVER=local
KLIPR_STORAGE_ROOT=storage
# For S3 on VPS: KLIPR_STORAGE_DRIVER=s3, plus endpoint/bucket/keys via VPS env only.
KLIPR_STORAGE_ENDPOINT=
KLIPR_STORAGE_BUCKET=klipr
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KLIPR_BILLING_ENABLED=false
KLIPR_CRM_LOG=crm/events.jsonl
KLIPR_AUTH_TOKEN_FILE=.klipr_admin_token
# Staging: KLIPR_ENV=staging, KLIPR_DATABASE_URL=.../klipr_staging, KLIPR_STORAGE_ROOT=storage_staging
