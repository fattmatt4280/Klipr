# Klipr - never commit secrets, user data, or dumps.
# Backups live on disk in backups/ (durable workspace), not in git.
.env
.env.*
!.env.example
.klipr_admin_token
*.token
storage/
storage_staging/
backups/
*.dump
# db/schema.sql is the source of truth and MUST stay tracked - dumps live in backups/ (ignored above), not in db/
crm/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.klipr_user_tokens
